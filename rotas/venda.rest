# @name login
POST http://localhost:8080/autenticacao/login
Content-Type: application/json

{
  "nomeUsuario": "vendedor-usuario-2",
  "senha": "123456"
}

@JWT = {{login.response.body.token}}

### Cadastrar uma nova venda
POST http://localhost:8080/1/venda/cadastrar
Content-Type: application/json
Authorization: Bearer {{JWT}}

{
  "cadastro": "2025-01-01",
  "cliente": {
    "id": 2
  },
  "vendedor": {
    "id": 3
  },
  "servicos": [
    {
      "id": 1
    }
  ],
  "mercadorias": [
    {
      "id": 1
    }
  ],
  "veiculo": {
    "id": 1
  }
}

### Obter todas as vendas
GET http://localhost:8080/1/vendas
Authorization: Bearer {{JWT}}

### Obter uma venda específica
GET http://localhost:8080/1/venda/2
Authorization: Bearer {{JWT}}

### Atualizar uma venda
PUT http://localhost:8080/1/venda/atualizar
Content-Type: application/json
Authorization: Bearer {{JWT}}

{
  "id": 1,
  "cadastro": "2025-01-01",
  "cliente": {
    "id": 2
  },
  "funcionario": {
    "id": 2
  },
  "mercadorias": [
    {
      "id": 1
    }
  ],
  "servicos": [
    {
      "id": 1
    }
  ],
  "veiculo": {
    "id": 2
  }
}

### Excluir uma venda
DELETE http://localhost:8080/1/venda/excluir
Content-Type: application/json
Authorization: Bearer {{JWT}}

{
  "id": 1
}